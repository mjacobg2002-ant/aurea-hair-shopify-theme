<section class="section container">
  {%- if section.settings.heading != blank -%}
    <div class="collection__head reveal">
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="h-lg">{{ section.settings.heading }}</h2>
    </div>
  {%- endif -%}

  <div class="category-grid">
    {%- for block in section.blocks -%}
      {%- liquid
        assign col = block.settings.collection
        assign url = col.url | default: block.settings.link | default: routes.all_products_collection_url
        assign img = block.settings.image | default: col.featured_image
      -%}
      <a class="category-card reveal" href="{{ url }}" {{ block.shopify_attributes }}>
        {%- if img != blank -%}
          <img src="{{ img | image_url: width: 1200 }}"
               srcset="{{ img | image_url: width: 700 }} 700w, {{ img | image_url: width: 1200 }} 1200w"
               sizes="(max-width:760px) 100vw, 50vw"
               width="{{ img.width }}" height="{{ img.height }}"
               alt="{{ img.alt | escape | default: block.settings.title | escape }}" loading="lazy">
        {%- elsif block.settings.fallback != blank -%}
          <img src="{{ block.settings.fallback | asset_url }}" alt="{{ block.settings.title | escape }}" loading="lazy">
        {%- else -%}
          {{ 'collection-2' | placeholder_svg_tag }}
        {%- endif -%}
        <div class="category-card__overlay">
          <h3>{{ block.settings.title | default: col.title }}</h3>
          <span>{{ block.settings.caption }}</span>
        </div>
      </a>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Aurea Category Grid",
  "max_blocks": 4,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The Collection" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop by Category" }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "image_picker", "id": "image", "label": "Image (overrides collection image)" },
        { "type": "text", "id": "title", "label": "Title", "default": "Wigs" },
        { "type": "text", "id": "caption", "label": "Caption", "default": "Shop Now" },
        { "type": "url", "id": "link", "label": "Fallback link (if no collection)" },
        { "type": "text", "id": "fallback", "label": "Bundled fallback image", "info": "Theme asset filename used until you pick an image." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Aurea Category Grid",
      "blocks": [
        { "type": "category", "settings": { "title": "Wigs", "caption": "HD Lace Units" } },
        { "type": "category", "settings": { "title": "Bundles", "caption": "Build Your Look" } },
        { "type": "category", "settings": { "title": "Closures", "caption": "5x5 · HD Lace" } },
        { "type": "category", "settings": { "title": "Frontals", "caption": "13x4 · Lace Fronts" } }
      ]
    }
  ]
}
{% endschema %}
