{%- liquid
  assign s = section.settings
  assign product = s.product
-%}
<section class="section container">
  {%- if product != blank -%}
    <div class="feature-product">
      <div class="feature-product__media reveal">
        {%- assign fmedia = product.featured_media -%}
        {%- if fmedia -%}
          <img src="{{ fmedia | image_url: width: 1200 }}"
               srcset="{{ fmedia | image_url: width: 700 }} 700w, {{ fmedia | image_url: width: 1200 }} 1200w"
               sizes="(max-width:900px) 100vw, 55vw"
               width="{{ fmedia.preview_image.width }}" height="{{ fmedia.preview_image.height }}"
               alt="{{ fmedia.alt | escape | default: product.title | escape }}" loading="lazy">
        {%- else -%}
          {{ 'product-1' | placeholder_svg_tag }}
        {%- endif -%}
      </div>

      <div class="feature-product__body reveal">
        {%- if s.eyebrow != blank -%}<p class="eyebrow">{{ s.eyebrow }}</p>{%- endif -%}
        <h2 class="h-md">{{ product.title }}</h2>

        <div class="feature-product__price" data-price>
          {%- assign v = product.selected_or_first_available_variant -%}
          {%- if v.compare_at_price > v.price -%}
            <span class="price--sale">{{ v.price | money }}</span>
            <span class="price--was">{{ v.compare_at_price | money }}</span>
          {%- else -%}
            <span>{{ v.price | money }}</span>
          {%- endif -%}
        </div>

        {%- if s.show_description and product.description != blank -%}
          <div class="feature-product__desc">{{ product.description | strip_html | truncatewords: 40 }}</div>
        {%- endif -%}

        <form data-product-form data-variants='
          {%- capture variants_json -%}[
            {%- for variant in product.variants -%}
              {"id":{{ variant.id }},"options":{{ variant.options | json }},"available":{{ variant.available }},"priceHtml":"{% if variant.compare_at_price > variant.price %}<span class='price--sale'>{{ variant.price | money }}</span> <span class='price--was'>{{ variant.compare_at_price | money }}</span>{% else %}<span>{{ variant.price | money }}</span>{% endif %}"}{%- unless forloop.last -%},{%- endunless -%}
            {%- endfor -%}
          ]{%- endcapture -%}
          {{ variants_json | escape }}'>

          {%- unless product.has_only_default_variant -%}
            <div class="variant-options">
              {%- for option in product.options_with_values -%}
                <div class="variant-option" data-option-index="{{ forloop.index0 }}">
                  <span class="variant-option__label">{{ option.name }}</span>
                  <div class="variant-values">
                    {%- for value in option.values -%}
                      {%- assign oid = section.id | append: '-' | append: forloop.parentloop.index0 | append: '-' | append: forloop.index0 -%}
                      <input type="radio" id="{{ oid }}" name="option-{{ forloop.parentloop.index0 }}" value="{{ value | escape }}" data-option{% if option.selected_value == value %} checked{% endif %}>
                      <label for="{{ oid }}">{{ value }}</label>
                    {%- endfor -%}
                  </div>
                </div>
              {%- endfor -%}
            </div>
          {%- endunless -%}

          <input type="hidden" data-variant-id value="{{ v.id }}">
          <div class="feature-product__actions">
            <button type="submit" class="btn" data-atc data-label="Add to Cart"{% unless product.available %} disabled{% endunless %}>
              {% if product.available %}Add to Cart{% else %}Sold Out{% endif %}
            </button>
            <a class="link-underline" href="{{ product.url }}">View Full Details</a>
          </div>
        </form>
      </div>
    </div>
  {%- else -%}
    <div class="collection__head reveal">
      <p class="eyebrow">Featured</p>
      <h2 class="h-lg">Select a product</h2>
      <p class="lede" style="margin:14px auto 0;">Choose a spotlight product in the Theme Editor.</p>
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Aurea Featured Product",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "In the Spotlight" },
    { "type": "product", "id": "product", "label": "Product" },
    { "type": "checkbox", "id": "show_description", "label": "Show short description", "default": true }
  ],
  "presets": [ { "name": "Aurea Featured Product" } ]
}
{% endschema %}
