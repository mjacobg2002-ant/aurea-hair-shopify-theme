<div class="announcement" data-announcement>
  <div class="announcement__track">
    {%- for block in section.blocks -%}
      <div class="announcement__item{% if forloop.first %} is-active{% endif %}" {{ block.shopify_attributes }}>
        {%- if block.settings.link != blank -%}
          <a href="{{ block.settings.link }}">{{ block.settings.text }}</a>
        {%- else -%}
          {{ block.settings.text }}
        {%- endif -%}
      </div>
    {%- else -%}
      <div class="announcement__item is-active">Welcome to Aurea Hair Co.</div>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Announcement bar",
  "max_blocks": 5,
  "blocks": [
    {
      "type": "message",
      "name": "Message",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "Complimentary shipping on qualifying orders" },
        { "type": "url", "id": "link", "label": "Link (optional)" }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "message", "settings": { "text": "WELCOME TO AUREA — LUXURY HAIR, UNCOMPROMISED" } },
      { "type": "message", "settings": { "text": "100% HUMAN HAIR · HD LACE" } }
    ]
  },
  "presets": [
    {
      "name": "Announcement bar",
      "blocks": [
        { "type": "message", "settings": { "text": "WELCOME TO AUREA — LUXURY HAIR, UNCOMPROMISED" } },
        { "type": "message", "settings": { "text": "100% HUMAN HAIR · HD LACE" } }
      ]
    }
  ]
}
{% endschema %}
