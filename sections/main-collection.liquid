<div class="page-hero container">
  <p class="eyebrow">Collection</p>
  <h1 class="display">{{ collection.title }}</h1>
  {%- if collection.description != blank -%}<div class="lede" style="margin:16px auto 0;">{{ collection.description }}</div>{%- endif -%}
</div>

<section class="section container" style="padding-top:0;">
  {%- paginate collection.products by 16 -%}
    {%- if collection.products.size > 0 -%}
      <div class="product-grid">
        {%- for product in collection.products -%}
          {% render 'product-card', product: product, show_quick_add: true, show_hover: true %}
        {%- endfor -%}
      </div>
      {%- if paginate.pages > 1 -%}
        <nav class="center" style="margin-top:48px;" aria-label="Pagination">
          {%- for part in paginate.parts -%}
            {%- if part.is_link -%}
              <a class="header__link" href="{{ part.url }}" style="display:inline-block;margin:0 8px;">{{ part.title }}</a>
            {%- else -%}
              <span class="header__link" style="display:inline-block;margin:0 8px;opacity:.5;">{{ part.title }}</span>
            {%- endif -%}
          {%- endfor -%}
        </nav>
      {%- endif -%}
    {%- else -%}
      <div class="empty-state"><h2 class="h-md">No products yet</h2><p>Check back soon.</p><a class="btn" href="{{ routes.all_products_collection_url }}">Shop All</a></div>
    {%- endif -%}
  {%- endpaginate -%}
</section>

{% schema %}
{ "name": "Collection", "settings": [] }
{% endschema %}
