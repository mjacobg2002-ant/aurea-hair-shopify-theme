<section class="section container">
  <div class="collection__head reveal">
    {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
    <h2 class="h-lg">{{ section.settings.heading }}</h2>
    {%- if section.settings.subtext != blank -%}<p class="lede" style="margin:14px auto 0;">{{ section.settings.subtext }}</p>{%- endif -%}
  </div>

  <div class="gallery">
    {%- for block in section.blocks -%}
      {%- liquid
        assign img = block.settings.image
        assign size_class = ''
        if block.settings.size == 'tall'
          assign size_class = 'gallery__item--tall'
        elsif block.settings.size == 'wide'
          assign size_class = 'gallery__item--wide'
        endif
        assign url = block.settings.link
        if block.settings.contain
          assign size_class = size_class | append: ' pack'
        endif
      -%}
      <{% if url != blank %}a href="{{ url }}"{% else %}div{% endif %} class="gallery__item {{ size_class }} reveal" {{ block.shopify_attributes }}>
        {%- if img != blank -%}
          <img src="{{ img | image_url: width: 900 }}"
               srcset="{{ img | image_url: width: 500 }} 500w, {{ img | image_url: width: 900 }} 900w"
               sizes="(max-width:760px) 50vw, 25vw"
               width="{{ img.width }}" height="{{ img.height }}"
               alt="{{ img.alt | escape | default: block.settings.caption | escape | default: 'Aurea look' }}" loading="lazy">
        {%- elsif block.settings.fallback != blank -%}
          <img src="{{ block.settings.fallback | asset_url }}" alt="{{ block.settings.caption | escape | default: 'Aurea look' }}" loading="lazy">
        {%- else -%}
          {{ 'lifestyle-1' | placeholder_svg_tag }}
        {%- endif -%}
        {%- if block.settings.caption != blank -%}
          <div class="category-card__overlay"><span>{{ block.settings.caption }}</span></div>
        {%- endif -%}
      </{% if url != blank %}a{% else %}div{% endif %}>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Aurea Gallery",
  "max_blocks": 8,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "@shopaureahair" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop the Look" },
    { "type": "text", "id": "subtext", "label": "Sub text", "default": "Aurea, worn." }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "select", "id": "size", "label": "Size", "options": [ { "value": "square", "label": "Square" }, { "value": "tall", "label": "Tall" }, { "value": "wide", "label": "Wide" } ], "default": "square" },
        { "type": "text", "id": "caption", "label": "Caption (optional)" },
        { "type": "url", "id": "link", "label": "Link (optional)" },
        { "type": "text", "id": "fallback", "label": "Bundled fallback image", "info": "Theme asset filename used until you pick an image." },
        { "type": "checkbox", "id": "contain", "label": "Fit whole image (packshot)", "default": false, "info": "Use for product flatlays so nothing is cropped." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Aurea Gallery",
      "blocks": [
        { "type": "image", "settings": { "size": "tall" } },
        { "type": "image", "settings": { "size": "square" } },
        { "type": "image", "settings": { "size": "square" } },
        { "type": "image", "settings": { "size": "wide" } },
        { "type": "image", "settings": { "size": "square" } }
      ]
    }
  ]
}
{% endschema %}
