<section class="section container">
  <div class="texture__head reveal">
    <div>
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="h-lg">{{ section.settings.heading }}</h2>
    </div>
    {%- if section.settings.link_label != blank -%}
      <a class="link-underline" href="{{ section.settings.link | default: routes.all_products_collection_url }}">{{ section.settings.link_label }}</a>
    {%- endif -%}
  </div>

  <div class="texture__grid">
    {%- for block in section.blocks -%}
      {%- liquid
        assign col = block.settings.collection
        assign url = col.url | default: block.settings.link | default: routes.all_products_collection_url
        assign img = block.settings.image | default: col.featured_image
      -%}
      <a class="texture-card reveal" href="{{ url }}" {{ block.shopify_attributes }}>
        <div class="texture-card__media">
          {%- if img != blank -%}
            <img src="{{ img | image_url: width: 800 }}"
                 srcset="{{ img | image_url: width: 500 }} 500w, {{ img | image_url: width: 800 }} 800w, {{ img | image_url: width: 1100 }} 1100w"
                 sizes="(max-width:760px) 78vw, 33vw"
                 width="{{ img.width }}" height="{{ img.height }}"
                 alt="{{ img.alt | escape | default: block.settings.title | escape }}" loading="lazy">
          {%- elsif block.settings.fallback != blank -%}
            <img src="{{ block.settings.fallback | asset_url }}" alt="{{ block.settings.title | escape }} hair" loading="lazy">
          {%- else -%}
            {{ 'collection-1' | placeholder_svg_tag }}
          {%- endif -%}
        </div>
        <div class="texture-card__label">
          <h3>{{ block.settings.title | default: col.title }}</h3>
          <span>{{ block.settings.caption }}</span>
        </div>
      </a>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Aurea Shop by Texture",
  "max_blocks": 3,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Find Your Texture" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop by Texture" },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "View All" },
    { "type": "url", "id": "link", "label": "Link" }
  ],
  "blocks": [
    {
      "type": "texture",
      "name": "Texture card",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "image_picker", "id": "image", "label": "Image (overrides collection image)" },
        { "type": "text", "id": "title", "label": "Title", "default": "Curly" },
        { "type": "text", "id": "caption", "label": "Caption", "default": "Shop Now" },
        { "type": "url", "id": "link", "label": "Fallback link (if no collection)" },
        { "type": "text", "id": "fallback", "label": "Bundled fallback image", "info": "Theme asset filename used until you pick an image." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Aurea Shop by Texture",
      "blocks": [
        { "type": "texture", "settings": { "title": "Curly", "caption": "Shop Curly" } },
        { "type": "texture", "settings": { "title": "Wavy", "caption": "Shop Wavy" } },
        { "type": "texture", "settings": { "title": "Straight", "caption": "Shop Straight" } }
      ]
    }
  ]
}
{% endschema %}
