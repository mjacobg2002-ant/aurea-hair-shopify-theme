<section class="section newsletter">
  <div class="container reveal">
    {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
    <h2 class="h-lg">{{ section.settings.heading }}</h2>
    {%- if section.settings.text != blank -%}<p class="lede">{{ section.settings.text }}</p>{%- endif -%}

    {%- form 'customer', class: 'newsletter__form' -%}
      <input type="hidden" name="contact[tags]" value="newsletter, aurea-list">
      <label class="visually-hidden" for="NewsletterEmail">Email address</label>
      <input type="email" id="NewsletterEmail" name="contact[email]" placeholder="Email address" required autocomplete="email">
      <button type="submit" aria-label="Subscribe">Join &rarr;</button>
      {%- if form.posted_successfully? -%}
        <p class="newsletter__success" style="grid-column:1/-1;">Welcome to the Aurea List.</p>
      {%- endif -%}
      {%- if form.errors -%}
        <p class="newsletter__success" style="grid-column:1/-1;">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>
      {%- endif -%}
    {%- endform -%}

    {%- if section.settings.note != blank -%}<p class="newsletter__note">{{ section.settings.note }}</p>{%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Aurea Newsletter",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Aurea VIP" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Join the Aurea List" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Be first to know about new drops and restocks." },
    { "type": "text", "id": "note", "label": "Fine print", "default": "By subscribing you agree to receive Aurea emails. Unsubscribe anytime." }
  ],
  "presets": [ { "name": "Aurea Newsletter" } ]
}
{% endschema %}
