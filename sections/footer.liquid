<footer class="footer">
  <div class="container">
    <div class="footer__top">
      <div class="footer__brand">
        {%- if section.settings.logo != blank -%}
          <img src="{{ section.settings.logo | image_url: width: 300 }}" alt="{{ shop.name | escape }}" width="150" style="margin-bottom:16px;">
        {%- else -%}
          <div class="footer__brand-name">Aurea<span>.</span></div>
        {%- endif -%}
        <p class="footer__statement">{{ section.settings.statement }}</p>
        <div class="footer__social">
          {%- if section.settings.instagram != blank -%}<a href="{{ section.settings.instagram }}" aria-label="Instagram" target="_blank" rel="noopener">{% render 'icon', name: 'instagram' %}</a>{%- endif -%}
          {%- if section.settings.tiktok != blank -%}<a href="{{ section.settings.tiktok }}" aria-label="TikTok" target="_blank" rel="noopener">{% render 'icon', name: 'tiktok' %}</a>{%- endif -%}
          {%- if section.settings.facebook != blank -%}<a href="{{ section.settings.facebook }}" aria-label="Facebook" target="_blank" rel="noopener">{% render 'icon', name: 'facebook' %}</a>{%- endif -%}
        </div>
      </div>

      {%- for block in section.blocks -%}
        <div class="footer__col" {{ block.shopify_attributes }}>
          <h4>{{ block.settings.heading }}</h4>
          {%- if block.settings.menu != blank -%}
            <ul>
              {%- for link in block.settings.menu.links -%}
                <li><a href="{{ link.url }}">{{ link.title }}</a></li>
              {%- endfor -%}
            </ul>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>

    <div class="footer__bottom">
      <span>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. All rights reserved.</span>
      <span>{{ powered_by_link }}</span>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Footer logo (optional)" },
    { "type": "textarea", "id": "statement", "label": "Brand statement", "default": "Aurea Hair Co. — luxury wigs, bundles and lace crafted for an elevated, effortless finish." },
    { "type": "header", "content": "Social" },
    { "type": "url", "id": "instagram", "label": "Instagram URL" },
    { "type": "url", "id": "tiktok", "label": "TikTok URL" },
    { "type": "url", "id": "facebook", "label": "Facebook URL" }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Link column",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Shop" },
        { "type": "link_list", "id": "menu", "label": "Menu" }
      ]
    }
  ],
  "max_blocks": 4,
  "default": {
    "settings": {
      "instagram": "https://www.instagram.com/shopaureahair/"
    },
    "blocks": [
      { "type": "menu", "settings": { "heading": "Shop", "menu": "main-menu" } },
      { "type": "menu", "settings": { "heading": "Customer Care", "menu": "footer" } },
      { "type": "menu", "settings": { "heading": "Company", "menu": "footer" } }
    ]
  },
  "presets": [
    {
      "name": "Footer",
      "blocks": [
        { "type": "menu", "settings": { "heading": "Shop" } },
        { "type": "menu", "settings": { "heading": "Customer Care" } },
        { "type": "menu", "settings": { "heading": "Company" } }
      ]
    }
  ]
}
{% endschema %}
