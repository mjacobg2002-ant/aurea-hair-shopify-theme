<section class="section testimonials">
  <div class="container">
    <div class="collection__head reveal">
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="h-lg">{{ section.settings.heading }}</h2>
    </div>
    <div class="testimonials__grid">
      {%- for block in section.blocks -%}
        <figure class="testimonial reveal" {{ block.shopify_attributes }}>
          <div class="testimonial__stars" aria-label="{{ block.settings.rating }} out of 5 stars">
            {%- for i in (1..5) -%}{% if i <= block.settings.rating %}★{% else %}☆{% endif %}{%- endfor -%}
          </div>
          <blockquote class="testimonial__text">“{{ block.settings.quote }}”</blockquote>
          <figcaption class="testimonial__name">
            {{ block.settings.name }}
            {%- if block.settings.verified -%}<span class="testimonial__verified">Verified Buyer</span>{%- endif -%}
          </figcaption>
        </figure>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Aurea Testimonials",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Reviews" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Loved by Aurea Customers" }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        { "type": "range", "id": "rating", "label": "Rating", "min": 1, "max": 5, "step": 1, "default": 5 },
        { "type": "textarea", "id": "quote", "label": "Quote" },
        { "type": "text", "id": "name", "label": "Customer name" },
        { "type": "checkbox", "id": "verified", "label": "Show 'Verified Buyer'", "default": false }
      ]
    }
  ],
  "presets": [
    {
      "name": "Aurea Testimonials",
      "blocks": [
        { "type": "review", "settings": { "rating": 5, "quote": "Hair is great quality and the lace melts effortlessly.", "name": "Renae W." } },
        { "type": "review", "settings": { "rating": 5, "quote": "Best curly hair I ever purchased. I will be back for the straight bundles.", "name": "Nicole V." } },
        { "type": "review", "settings": { "rating": 5, "quote": "Love love love my wig. Came right on time for my vacation.", "name": "Aaliyah S." } }
      ]
    }
  ]
}
{% endschema %}
