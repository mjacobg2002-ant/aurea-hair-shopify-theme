<div class="page-hero container">
  <p class="eyebrow">Explore</p>
  <h1 class="display">Collections</h1>
</div>

<section class="section container" style="padding-top:0;">
  <div class="category-grid">
    {%- for collection in collections -%}
      <a class="category-card" href="{{ collection.url }}">
        {%- if collection.featured_image -%}
          <img src="{{ collection.featured_image | image_url: width: 1200 }}" alt="{{ collection.featured_image.alt | escape | default: collection.title | escape }}" loading="lazy" width="1200" height="750">
        {%- else -%}
          {{ 'collection-1' | placeholder_svg_tag }}
        {%- endif -%}
        <div class="category-card__overlay"><h3>{{ collection.title }}</h3><span>Shop Now</span></div>
      </a>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{ "name": "Collections list", "settings": [] }
{% endschema %}
