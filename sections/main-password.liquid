<section class="hero hero--align-center" style="--hero-h:100vh;">
  <div class="hero__media" style="height:100vh;min-height:520px;">
    {%- if section.settings.use_video -%}
      <video class="hero__video" autoplay muted loop playsinline preload="auto"
             poster="{{ 'aurea-hero-poster.jpg' | asset_url }}" aria-label="Aurea Hair Co.">
        <source src="{{ 'aurea-hero.mp4' | asset_url }}" type="video/mp4">
        <img src="{{ 'aurea-hero-poster.jpg' | asset_url }}" alt="Aurea Hair Co.">
      </video>
    {%- else -%}
      <img class="hero__img--desktop" src="{{ 'aurea-hero-poster.jpg' | asset_url }}" alt="Aurea Hair Co.">
      <img class="hero__img--mobile" src="{{ 'aurea-hero-poster.jpg' | asset_url }}" alt="Aurea Hair Co.">
    {%- endif -%}
    <div class="hero__overlay" style="background:rgba(22,19,15,.55);"></div>
  </div>

  <div class="hero__content">
    <div class="container"><div class="hero__inner" style="margin-inline:auto;text-align:center;">
      <p class="eyebrow" style="color:rgba(247,242,234,.85);">{{ shop.name }}</p>
      <h1 class="hero__title" style="color:var(--ivory);">{{ section.settings.heading }}</h1>
      {%- if section.settings.text != blank -%}
        <div class="hero__text" style="margin-inline:auto;">{{ section.settings.text }}</div>
      {%- endif -%}

      {%- form 'storefront_password', class: 'newsletter__form', style: 'margin:28px auto 0;' -%}
        <label class="visually-hidden" for="PasswordInput">Enter store password</label>
        <input type="password" id="PasswordInput" name="password" placeholder="Enter password" required>
        <button type="submit" aria-label="Enter">Enter &rarr;</button>
        {%- if form.errors -%}
          <p class="newsletter__success" style="grid-column:1/-1;">{{ form.errors.messages['form'] | default: 'Wrong password. Please try again.' }}</p>
        {%- endif -%}
      {%- endform -%}

      <p class="newsletter__note" style="color:rgba(247,242,234,.6);margin-top:18px;">
        Are you the store owner? <a href="/admin" style="color:var(--champagne);text-decoration:underline;">Log in here</a>.
      </p>
    </div></div>
  </div>
</section>

{% schema %}
{
  "name": "Password",
  "settings": [
    { "type": "checkbox", "id": "use_video", "label": "Use background video", "default": true },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Opening Soon" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Aurea Hair Co. — luxury hair, arriving soon. Enter the password to preview." }
  ]
}
{% endschema %}
