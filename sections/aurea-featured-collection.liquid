{%- liquid
  assign s = section.settings
  assign col = s.collection
  assign limit = s.count
-%}
<section class="section container">
  <div class="collection__head reveal">
    {%- if s.eyebrow != blank -%}<p class="eyebrow">{{ s.eyebrow }}</p>{%- endif -%}
    <h2 class="h-lg">{{ s.heading }}</h2>
    {%- if s.subtext != blank -%}<p class="lede" style="margin:14px auto 0;">{{ s.subtext }}</p>{%- endif -%}
  </div>

  <div class="product-grid">
    {%- if col != blank and col.products.size > 0 -%}
      {%- for product in col.products limit: limit -%}
        {% render 'product-card', product: product, show_quick_add: s.quick_add, show_hover: s.hover_image %}
      {%- endfor -%}
    {%- else -%}
      {%- for i in (1..4) -%}
        <div class="product-card reveal">
          <div class="product-card__media">{{ 'product-1' | placeholder_svg_tag }}</div>
          <h3 class="product-card__title">Example Product</h3>
          <span class="product-card__price"><span>$0.00</span></span>
        </div>
      {%- endfor -%}
    {%- endif -%}
  </div>

  {%- if s.button_label != blank -%}
    <div class="center reveal" style="margin-top:clamp(34px,5vw,58px);">
      <a class="btn btn--ghost" href="{{ col.url | default: routes.all_products_collection_url }}">{{ s.button_label }}</a>
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Aurea Featured Collection",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Best Sellers" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The Aurea Edit" },
    { "type": "text", "id": "subtext", "label": "Sub text", "default": "The pieces our customers reach for again and again." },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "count", "label": "Products to show", "min": 4, "max": 12, "step": 4, "default": 4 },
    { "type": "checkbox", "id": "quick_add", "label": "Enable quick add", "default": true },
    { "type": "checkbox", "id": "hover_image", "label": "Show 2nd image on hover", "default": true },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop the Edit" }
  ],
  "presets": [ { "name": "Aurea Featured Collection" } ]
}
{% endschema %}
