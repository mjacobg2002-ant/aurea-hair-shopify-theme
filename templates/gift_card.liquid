{% layout none %}
<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ shop.name }} — Gift Card</title>
  {{ 'base.css' | asset_url | stylesheet_tag }}
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500&family=Jost:wght@300;400;500&display=swap">
</head>
<body class="template-gift-card">
  <section class="section container center" style="max-width:560px;">
    <p class="eyebrow">{{ shop.name }}</p>
    <h1 class="h-lg">Your Gift Card</h1>
    <p class="lede" style="margin:14px auto 24px;">A gift card worth {{ gift_card.initial_value | money }}.</p>
    <div style="border:1px solid var(--line);padding:34px;border-radius:2px;background:var(--cream);">
      <div style="font-family:var(--font-serif);font-size:1.6rem;letter-spacing:.08em;word-break:break-all;">
        {{ gift_card.code | format_code }}
      </div>
      <p class="newsletter__note" style="color:var(--ink-soft);margin-top:16px;">
        Remaining balance: {{ gift_card.balance | money }}
      </p>
    </div>
    <div style="margin-top:26px;"><a class="btn" href="{{ shop.url }}">Shop Aurea</a></div>
  </section>
</body>
</html>
